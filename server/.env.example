# ---------- Claude ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# ---------- Salesforce (JWT bearer flow) ----------
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=<Connected App consumer key>
SF_USERNAME=devops.integration@yourorg.com
SF_PRIVATE_KEY_PATH=./secrets/sf-server.key

# ---------- Git (GitHub App) ----------
GIT_PROVIDER=github
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_OWNER=saranrajv11
GITHUB_REPO=Moon-DevopsAgent

# ---------- CI/CD ----------
# one of: github-actions | jenkins | mock
CICD_PROVIDER=mock
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# ---------- Server ----------
PORT=3001
FEATURE_BRANCH_PATTERN=^feature/(\d{4})$
CONFIRMATION_TTL_SECONDS=300

# Shared secret presented by the Apex Named Credential
APEX_SHARED_SECRET=

# Require the PR to be merged (not just approved) before promoting past DEV
REQUIRE_MERGED_PR_BEYOND_DEV=true

# Validation workspace: where PR head commits are checked out
WORKSPACE_ROOT=/tmp/sfdevops-workspaces
SOURCE_PATH=force-app

# Org aliases per environment (defaults to lowercase env name)
SF_ORG_DEV=
SF_ORG_QA=
SF_ORG_PROD=
